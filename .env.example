# Copy to .env and fill in real values. NEVER commit .env.
# .env permission must be 0600 (handled by Makefile and refresh logic).

# ============================================
# Haravan Omni API (haravan-elt)
# ============================================
HARAVAN_SHOP_DOMAIN=myshop.myharavan.com
HARAVAN_ACCESS_TOKEN=replace-with-real-token
HARAVAN_REFRESH_TOKEN=replace-with-real-refresh-token
HARAVAN_CLIENT_ID=replace-with-client-id
HARAVAN_CLIENT_SECRET=replace-with-client-secret

# ============================================
# PostgreSQL (haravan-elt) — DEV ONLY credentials, override in prod
# ============================================
# Note: docker-compose maps host 5434 -> container 5432 to avoid clashes (5432 = local PG, 5433 = flowbyte)
DATABASE_URL=postgresql://elt_user:elt_pass@localhost:5434/haravan

# ============================================
# Telegram Bot (haravan-elt + Claude Code hooks share)
# ============================================
# From @BotFather. Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=
# DM id (positive) or group id (negative, e.g. -100123456789)
TELEGRAM_CHAT_ID=

# ============================================
# Discord (Claude Code hooks only)
# ============================================
DISCORD_WEBHOOK_URL=

# ============================================
# Runtime (haravan-elt)
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=console            # json | console
HARAVAN_RATE_LIMIT_PER_SEC=4
HARAVAN_RATE_LIMIT_BURST=80
EXTRACT_BATCH_SIZE=250
LOAD_BATCH_SIZE=500
TIMEZONE=Asia/Ho_Chi_Minh
